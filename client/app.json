{
  "expo": {
    "name": "LOOCHKA",
    "slug": "shulchan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shulchan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/AppIcon.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "People at your table see your camera live. LOOCHKA does not record or store it.",
        "NSMicrophoneUsageDescription": "People at your table hear you live. LOOCHKA does not record or store it."
      },
      "bitcode": false,
      "bundleIdentifier": "com.loochka",
      "usesAppleSignIn": true
    },
    "android": {
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.BLUETOOTH"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#997000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.loochka"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4C3500",
          "image": "./assets/images/splash.jpg",
          "resizeMode": "cover",
          "imageWidth": 288
        }
      ],
      "./plugins/withSplashBackground",
      "./plugins/withSceneLifecycle",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1060524753529308~8002841923",
          "iosAppId": "ca-app-pub-1060524753529308~2890291058",
          "delayAppMeasurementInit": true,
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-apple-authentication",
      "expo-localization",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": []
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/play"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c95d2f5-91a6-4eca-bc2c-c72806b29e79"
      }
    },
    "owner": "shl3vi"
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-1060524753529308~8002841923",
    "ios_app_id": "ca-app-pub-1060524753529308~2890291058",
    "delay_app_measurement_init": true
  }
}
